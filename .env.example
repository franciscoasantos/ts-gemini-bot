# --- TeamSpeak ---
TS_HOST=my.server.com
TS_PORT=9987
TS_NICK=Gemini
# Name or ID of the channel the bot sits in (empty = default channel)
TS_CHANNEL=
TS_CHANNEL_PASSWORD=
TS_SERVER_PASSWORD=

# --- Gemini (https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
# Pin a specific model, not a "-latest" alias: the alias repoints to the newest Flash, which can
# have a tiny free-tier quota (gemini-3.8-flash = 20 requests/day). The lite tier is more generous.
GEMINI_TEXT_MODEL=gemini-3.1-flash-lite
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview

# Language the bot REPLIES in (e.g. pt-BR, en). Code/logs stay English; only user-facing output
# follows this. Unknown codes are passed to Gemini as-is; built-in strings fall back to English.
BOT_LANGUAGE=pt-BR

# --- Wake word (Portuguese recognition via Whisper + VAD) ---
# Model folder (downloaded during the Docker build)
KWS_DIR=/app/model
# Whisper model size: tiny | base | small (must match the one downloaded in the Dockerfile)
WHISPER_PREFIX=base
# Words that activate the bot (regex; the transcription must contain one of them)
WAKE_WORDS=ok google|google
# Recognizer threads
ASR_THREADS=2

# --- Behavior ---
# Milliseconds of silence until the conversation ends (releases it for someone else)
CONVO_IDLE_MS=12000
# Autoplay: while a song plays, keep the queue filled with similar songs (chosen by Gemini) so it
# never stops. AUTOPLAY=1 enables it at boot; it can also be toggled by voice ("autoplay on/off").
# It refills in batches (one Gemini call per BATCH songs) once the queue drops below QUEUE_AHEAD.
AUTOPLAY=0
AUTOPLAY_QUEUE_AHEAD=2
AUTOPLAY_BATCH=5
AUTOPLAY_POLL_MS=15000
# Nicknames to ignore in detection (empty = uses MUSIC_BOT_NAME). Comma-separated.
IGNORE_SPEAKERS=
# BEEP=0 turns off the audio cues
# DEBUG_VOICE=1 logs what the bot hears/transcribes

# Bot identity (persist in a Docker volume) and avatar
IDENTITY_FILE=/app/data/identity.json
AVATAR_FILE=avatar.png

# --- TS6 Manager integration (play music by voice) ---
# Leave USER/PASS empty to disable the music commands.
MANAGER_URL=http://backend:3001/api
MANAGER_USER=
MANAGER_PASS=
MUSIC_BOT_NAME=DJ Morri
